# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project credentials
# Available from Firebase Console: Project Settings

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# App Check - reCAPTCHA Enterprise site key (create at console.cloud.google.com/security/recaptcha)
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=your_recaptcha_enterprise_site_key

# Web push (Firebase Cloud Messaging) - Web Push certificate key pair, from
# Firebase Console > Project Settings > Cloud Messaging > Web configuration.
# Leave unset to ship without push; the in-app notification bell still works.
VITE_FIREBASE_VAPID_KEY=your_web_push_vapid_key
